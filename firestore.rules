rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

// --- AI活用事例（社員のみ閲覧・投稿。更新はいいね数のみ） ---
    // 事例には氏名・メールが含まれるため、閲覧も社員ログインに限定する。
    match /aiStudy_cases/{caseId} {
      allow read: if aiStudyIsStaff();
      allow create: if aiStudyIsStaff()
                    && request.resource.data.keys().hasAll(['email','tool','title','body'])
                    && request.resource.data.email == aiStudyEmail()
                    && request.resource.data.title is string
                    && request.resource.data.title.size() > 0
                    && request.resource.data.title.size() < 200
                    && request.resource.data.likesCount == 0;
      // 更新は likesCount の ±1 のみ。いいね記録(aiStudy_likes)の作成/削除と同時でなければ拒否し、
      // 1人が何度も押して件数を水増しできないようにする。
      allow update: if aiStudyIsStaff()
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likesCount'])
                    && request.resource.data.likesCount is int
                    && request.resource.data.likesCount >= 0
                    && ((request.resource.data.likesCount == resource.data.likesCount + 1
                         && !exists(aiStudyLikePath(caseId)) && existsAfter(aiStudyLikePath(caseId)))
                     || (request.resource.data.likesCount == resource.data.likesCount - 1
                         && exists(aiStudyLikePath(caseId)) && !existsAfter(aiStudyLikePath(caseId))));
      allow delete: if aiStudyIsAdmin();
    }

    // --- 社員マスタ（氏名・部門の自動判定に使用。登録は管理者のみ） ---
    match /aiStudy_employees/{email} {
      allow read: if aiStudyIsStaff();
      allow write: if aiStudyIsAdmin();
    }

    // --- いいね記録（ドキュメントIDは「事例ID_uid」。本人の分だけ作成・削除できる） ---
    match /aiStudy_likes/{likeId} {
      // IDの末尾が自分のuidのものだけ読める（未作成のドキュメントの存在確認もできるように）
      allow read: if aiStudySignedIn() && likeId.matches('.*_' + request.auth.uid + '$');
      allow create: if aiStudyIsStaff()
                    && request.resource.data.keys().hasOnly(['caseId','uid','createdAt'])
                    && request.resource.data.uid == request.auth.uid
                    && likeId == request.resource.data.caseId + '_' + request.auth.uid;
      allow delete: if aiStudySignedIn() && resource.data.uid == request.auth.uid;
      allow update: if false;
    }

    // --- AIアイデア掲示板（ログイン不要で閲覧・投稿・返信可） ---
    match /aiStudy_boardPosts/{postId} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['type','name','title','body','createdAt'])
        && request.resource.data.type in ['question', 'idea', 'wish']
        && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 30
        && request.resource.data.title is string && request.resource.data.title.size() > 0 && request.resource.data.title.size() <= 100
        && request.resource.data.body is string && request.resource.data.body.size() > 0 && request.resource.data.body.size() <= 1000;
      allow update: if false;
      allow delete: if aiStudyIsAdmin();   // 不適切な投稿の削除用
    }

    match /aiStudy_boardReplies/{replyId} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['postId','name','body','createdAt'])
        && request.resource.data.postId is string
        && exists(/databases/$(database)/documents/aiStudy_boardPosts/$(request.resource.data.postId))
        && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 30
        && request.resource.data.body is string && request.resource.data.body.size() > 0 && request.resource.data.body.size() <= 600;
      allow update: if false;
      allow delete: if aiStudyIsAdmin();
    }

    // ============================================================
    // exceed-secretary-system 統合ルール(2026-07 更新)
    //
    // ・旧テストモードルール(2026/5/6 期限)は既に失効していたため削除。
    // ・Admin SDK(サーバー側)からのアクセスはルールの影響を受けません。
    // ・もし秘書システムがブラウザ等のクライアントから直接Firestoreへ
    //   アクセスしている場合は、そのコレクション用のmatchブロックを
    //   別途追加してください(最下部の全拒否より上に記述)。
    // ============================================================

    // ---------- AI勉強会: ヘルパー ----------
    function aiStudySignedIn() {
      return request.auth != null;
    }
    function aiStudyAccess() {
      return get(/databases/$(database)/documents/aiStudy_settings/access).data;
    }
    function aiStudyEmail() {
      return request.auth.token.email.lower();
    }
    function aiStudyIsAdmin() {
      return aiStudySignedIn() && aiStudyEmail() in aiStudyAccess().admins;
    }
    // 社員判定: メール確認済みの社内ドメイン、または members / admins に登録されたアカウント
    function aiStudyIsStaff() {
      return aiStudySignedIn()
        && request.auth.token.email_verified == true
        && (aiStudyEmail().matches('.*@(ych-exceed[.]com|besto-haus[.]com|exceed-group[.]co[.]jp|yamagata[.]pg-house[.]jp)$')
            || aiStudyEmail() in aiStudyAccess().get('members', [])
            || aiStudyIsAdmin());
    }
    function aiStudyLikePath(caseId) {
      return /databases/$(database)/documents/aiStudy_likes/$(caseId + '_' + request.auth.uid);
    }
    // アンバサダー制度の提案ページを閲覧できる人（社長など）。admins は自動的に含む
    function aiStudyCanViewProposal() {
      return aiStudyIsAdmin()
        || (aiStudySignedIn() && aiStudyEmail() in aiStudyAccess().get('proposalViewers', []));
    }
    function aiStudyIsMember() {
      // 管理者は自動的に回答権も持つ
      return aiStudySignedIn()
        && (aiStudyEmail() in aiStudyAccess().members || aiStudyIsAdmin());
    }

    // ---------- AI勉強会: イベント情報 ----------
    // 閲覧: 誰でも(LP表示用) / 編集: 管理者のみ
    match /aiStudy_settings/event {
      allow read: if true;
      allow write: if aiStudyIsAdmin();
    }

    // ---------- AI勉強会: 権限リスト ----------
    // 読み書きとも管理者のみ(=読めるか否かで管理者判定)
    match /aiStudy_settings/access {
      allow read, write: if aiStudyIsAdmin();
    }

    // ---------- AI勉強会: 出欠回答 ----------
    match /aiStudy_responses/{uid} {
      allow read: if aiStudySignedIn()
        && (request.auth.uid == uid || aiStudyIsAdmin());
      allow create, update: if aiStudyIsMember()
        && request.auth.uid == uid
        && request.resource.data.email.lower() == aiStudyEmail()
        && request.resource.data.status == "absent";
      allow delete: if aiStudySignedIn()
        && (request.auth.uid == uid || aiStudyIsAdmin());
    }

    // ---------- AI勉強会: 実施後の出欠記録 ----------
    // 管理者が実施日ごとの出席・欠席・備考を確定、修正するための台帳
    match /aiStudy_attendance/{attendanceId} {
      allow read, write: if aiStudyIsAdmin();
    }

    // ---------- AI勉強会: 参加後アンケート ----------
    match /aiStudy_surveys/{surveyId} {
      allow read: if aiStudyIsAdmin();
      // アンケートは回答権リストへの登録有無にかかわらず、Google ログイン済みの
      // 参加者が回答できるようにする。保存データはログイン本人にひも付ける。
      allow create: if aiStudyIsStaff()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email.lower() == aiStudyEmail();
      allow update: if aiStudyIsStaff()
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email.lower() == aiStudyEmail();
      allow delete: if aiStudyIsAdmin();
    }

    // ---------- 社内AI活用レベル診断 ----------
    // 回答者は本人の結果だけを保存・参照でき、全体集計は管理者だけが閲覧できます。
    match /aiStudy_aiDiagnostics/{uid} {
      allow read: if aiStudySignedIn()
        && (request.auth.uid == uid || aiStudyIsAdmin());
      allow create, update: if aiStudyIsStaff()
        && request.auth.uid == uid
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email.lower() == aiStudyEmail()
        && request.resource.data.score is int
        && request.resource.data.score >= 0
        && request.resource.data.score <= 56
        && request.resource.data.level is int
        && request.resource.data.level >= 1
        && request.resource.data.level <= 5;
      allow delete: if aiStudyIsAdmin();
    }

    // 診断は回答のたびに追記し、過去結果を上書きせず成長を確認できるようにします。
    match /aiStudy_aiDiagnosticResponses/{responseId} {
      allow read: if aiStudyIsAdmin();
      allow create: if aiStudyIsStaff()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email.lower() == aiStudyEmail()
        && request.resource.data.score is int
        && request.resource.data.score >= 0
        && request.resource.data.score <= 56
        && request.resource.data.level is int
        && request.resource.data.level >= 1
        && request.resource.data.level <= 5;
      allow update: if false;
      allow delete: if aiStudyIsAdmin();
    }

    // ---------- AIアンバサダー制度: 提案・運用ページ（ambassador.html） ----------
    // 本文はリポジトリに置かず Firestore にだけ保存する（公開リポジトリから内部方針が漏れないように）。
    // 閲覧: admins + proposalViewers / 修正: admins のみ
    match /aiStudy_ambassador/{docId} {
      allow read: if aiStudyCanViewProposal();
      allow write: if aiStudyIsAdmin()
        && request.resource.data.updatedBy == aiStudyEmail()
        && request.resource.data.content is string
        && request.resource.data.content.size() < 500000;
    }
    // 修正履歴（追記のみ。過去版の改ざん・削除はできない）
    match /aiStudy_ambassadorHistory/{revId} {
      allow read: if aiStudyIsAdmin();
      allow create: if aiStudyIsAdmin()
        && request.resource.data.updatedBy == aiStudyEmail()
        && request.resource.data.content is string
        && request.resource.data.content.size() < 500000;
      allow update, delete: if false;
    }
    // 社長・閲覧者からの判断（承認／保留／要修正）とコメント。項目ごとに最新の判断を保持
    match /aiStudy_ambassadorFeedback/{itemId} {
      allow read: if aiStudyCanViewProposal();
      allow write: if aiStudyCanViewProposal()
        && request.resource.data.keys().hasOnly(['status','comment','by','byName','at'])
        && request.resource.data.status in ['approve','hold','revise','none']
        && request.resource.data.comment is string
        && request.resource.data.comment.size() <= 2000
        && request.resource.data.by == aiStudyEmail();
    }

    // ---------- 運営コンソール: AIツール利用者台帳（console.html） ----------
    // ドキュメントIDは利用者のメール（小文字）。付与・変更・卒業の記録は管理者のみ
    match /aiStudy_licenses/{email} {
      allow read, write: if aiStudyIsAdmin();
    }

    // ---------- 運営コンソール: Slack #ask-ai勉強会 の自動確認結果 ----------
    // 書き込みは Google Apps Script（gas/slack-monitor）が Firestore REST API で行う。
    // GAS は IAM 権限で書き込むため、このルールの影響を受けない（ブラウザからは書けない）。
    match /aiStudy_slackThreads/{threadId} {
      allow read: if aiStudyIsAdmin();
      allow write: if false;
    }
    match /aiStudy_slackSync/{docId} {
      allow read: if aiStudyIsAdmin();
      allow write: if false;
    }

    // ---------- 上記以外は全拒否 ----------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
